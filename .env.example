# Public site URL used for canonical URLs, sitemap, robots and social metadata.
# Local development: http://localhost:3000
# Production: your real Vercel/custom domain, e.g. https://devansh.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email delivery (Resend).
# Create a free API key at https://resend.com/api-keys
# Without RESEND_API_KEY the form validates input but returns an honest
# "not configured" state and points visitors to the direct email address.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=devanshavchat8208@gmail.com

# Verified sender. Use "Your Name <hello@yourdomain.com>" once your domain is
# verified in Resend. The default below only works for Resend test sending.
CONTACT_FROM_EMAIL=Devansh Portfolio <onboarding@resend.dev>
